generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Message {
  id              Int    @id @default(autoincrement())
  messageID       String @unique @db.VarChar(255)
  fromuser        String @db.VarChar(50)
  content         String @db.VarChar(500)
  createdat       String
  geolocation_lat Float
  geolocation_lng Float
  user            User?  @relation(fields: [fromuser], references: [username], onDelete: SetNull, onUpdate: Cascade)

  @@index([fromuser])
  @@index([createdat])
}

model User {
  id                Int       @id @default(autoincrement())
  username          String    @unique @db.VarChar(50)
  email             String?   @unique @db.VarChar(160)
  passwordHash      String?   @db.VarChar(120)
  avatar            String    @db.VarChar(255)
  socketID          String    @unique @db.VarChar(100)
  userID            String    @unique @db.VarChar(50)
  preferedDistance  Int
  room              String    @db.VarChar(100)
  geolocation_lat   Float
  geolocation_lng   Float
  beSeenBeyondRange Boolean
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  Message           Message[]
}

model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
