echo '🔨👷🔨 Styling, testing and building your project before committing 🔨👷🔨'

# Check Format standards
yarn check:format ||
(
    echo '❌🤢🤮❌ Format Check Failed. ❌🤮🤢❌
            Run yarn format, add changes and try commit again.';
    false;
)

# Check Lint Standards
yarn check:lint ||
(
        echo '❌😤👋❌ Lint Check Failed ❌👋😤❌ 
                Lint Check Failed. Make the required changes listed, add them and commit again.'
        false; 
)

# Check tsconfig standards
yarn check:types ||
(
    echo '❌🤡😂🤡❌ Failed Type check. ❌🤡😂🤡❌
            Make the required changes.'
    false;
)

# Check tests
echo '🤔🤔🤔🤔 ... so far so good ... Running tests ... 🤔🤔🤔🤔'

yarn test ||
(
    echo '❌👷🔨❌ Running tests failed ❌🔨👷❌
            View the errors above. 
    '
    false;
)

